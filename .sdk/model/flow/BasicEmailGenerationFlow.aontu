# BasicEmailGenerationFlow

main: kit: flow: BasicEmailGenerationFlow:
{
  entity: "email_generation",
  kind: "basic",
  name: "BasicEmailGenerationFlow",
  step: [
    {
      i: {
        ref: "email_generation_ref01",
        srcdatavar: "email_generation_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-email_generation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEmailGenerationFlow"
}