# Entity: email_inbox

main: kit: entity: email_inbox: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "messages"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "total"
      req: false
      short: "Total number of messages"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "email_inbox"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "temp_user_12345@kingtmp.email"
                kind: "param"
                name: "id"
                orig: "email"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /api/inbox/{email}"
            json: "{\"operationId\":\"getInbox\",\"parameters\":[{\"description\":\"The temporary email address to check\",\"example\":\"temp_user_12345@kingtmp.email\",\"in\":\"path\",\"name\":\"email\",\"required\":true,\"schema\":{\"format\":\"email\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"messages\":{\"items\":{\"properties\":{\"attachments\":{\"items\":{\"properties\":{\"content_type\":{\"example\":\"application/pdf\",\"type\":\"string\"},\"filename\":{\"example\":\"document.pdf\",\"type\":\"string\"},\"size\":{\"description\":\"File size in bytes\",\"example\":12345,\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"body\":{\"description\":\"Email body content\",\"example\":\"Thank you for signing up...\",\"type\":\"string\"},\"from\":{\"description\":\"Sender's email address\",\"example\":\"sender@example.com\",\"format\":\"email\",\"type\":\"string\"},\"id\":{\"description\":\"Unique message identifier\",\"example\":\"msg_123456\",\"type\":\"string\"},\"received_at\":{\"description\":\"Timestamp when the message was received\",\"example\":\"2024-01-01T10:30:00Z\",\"format\":\"date-time\",\"type\":\"string\"},\"subject\":{\"description\":\"Email subject line\",\"example\":\"Welcome to our service\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"total\":{\"description\":\"Total number of messages\",\"example\":5,\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Successfully retrieved inbox messages\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"example\":400,\"type\":\"integer\"},\"details\":{\"description\":\"Additional error details\",\"example\":\"The provided email address is invalid\",\"type\":\"string\"},\"error\":{\"description\":\"Error message\",\"example\":\"Invalid request\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Email address not found\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/api/inbox/{email}"
          rename: {
            param: {
              email: "id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "inbox"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
