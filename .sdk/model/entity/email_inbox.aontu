# Entity: email_inbox

main: kit: entity: email_inbox: {

  alias: field: {}

  fields: [
    {
      name: "messages"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "total"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "email_inbox"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "temp_user_12345@kingtmp.email"
                kind: "param"
                name: "id"
                orig: "email"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/inbox/{email}"
          parts: [
            "api"
            "inbox"
            "{id}"
          ]
          rename: {
            param: {
              email: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
