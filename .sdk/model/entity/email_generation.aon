# Entity: email_generation

main: kit: entity: email_generation: {

  alias: field: {}

  fields: [
    {
      name: "email"
      req: false
      short: "The generated temporary email address"
      type: "`$STRING`"
    }
    {
      name: "expires_at"
      req: false
      short: "Expiration timestamp of the temporary email"
      type: "`$STRING`"
    }
    {
      name: "token"
      req: false
      short: "Authentication token for accessing the mailbox"
      type: "`$STRING`"
    }
  ]

  name: "email_generation"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/generate"
          parts: [
            "api"
            "generate"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
