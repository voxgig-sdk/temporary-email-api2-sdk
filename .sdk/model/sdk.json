        "contact": {
          "url": "https://github.com/l0v3m0n3y/Kingtmpemail"
        },
        "description": "The Kingtmp.email API provides a service for generating temporary, secure, anonymous, and disposable email addresses to help users avoid spam and unwanted emails. This API allows users to create a temp mail that can be used to sign up for various online services while keeping their real mailbox clean and secure.",
        "servers": [
          {
            "description": "Production server",
            "url": "https://kingtmp.email"
          }
        ],
        "title": "Temporary Email API",
        "version": "1.0.0",
        "tagline": "Generate disposable email addresses and read their inboxes via a temporary mail API",
        "homepage": "https://kingtmp.email",
        "about_md": "Temporary Email API is a disposable / throwaway email service that lets you spin up short-lived email addresses on demand and read the messages they receive. The service is offered under the `kingtmp.email` domain.\n\nWhat you typically get from a temp-mail style API:\n\n- Create or request a new temporary email address\n- Poll the inbox for that address and read incoming messages (subject, sender, body)\n- Discard the address when you're done\n\nUseful for sign-up flows, automated testing of email-based onboarding, anti-spam experiments, and any workflow where you need a real-looking inbox without provisioning a permanent mailbox. Operational details such as message retention, rate limits, and authentication requirements are not documented on a public landing page at time of writing — check the upstream OpenAPI specification for exact endpoints and parameters.",
        "entity_desc": {
          "email_generation": "Operations for creating / requesting a fresh temporary email address that can receive mail.",
          "email_inbox": "Operations for listing and reading messages delivered to a previously-generated temporary address."
        },
        "auth": false
      },
